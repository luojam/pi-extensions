{
    "name": "pi-extensions",
    "private": true,
    "description": "Header, footer, and token accounting extensions for Pi",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/luojam/pi-extensions.git"
    },
    "homepage": "https://github.com/luojam/pi-extensions#readme",
    "bugs": {
        "url": "https://github.com/luojam/pi-extensions/issues"
    },
    "type": "module",
    "keywords": ["pi-package", "pi-extension", "pi", "header", "footer", "tokens"],
    "pi": {
        "extensions": [
            "./extensions/myhead/index.ts",
            "./extensions/myfoot/index.ts",
            "./extensions/mytokens/index.ts"
        ]
    },
    "peerDependencies": {
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.7",
        "@earendil-works/pi-coding-agent": "0.84.2",
        "@earendil-works/pi-tui": "0.84.2",
        "@types/node": "^24",
        "typebox": "1.3.7",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "scripts": {
        "test": "vitest run",
        "typecheck": "tsc --project tsconfig.json",
        "check": "biome check .",
        "check:write": "biome check --write .",
        "format": "biome format .",
        "format:write": "biome format --write ."
    }
}
